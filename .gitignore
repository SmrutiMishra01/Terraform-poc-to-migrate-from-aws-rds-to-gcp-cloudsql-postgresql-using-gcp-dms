# Local .terraform directories
**/.terraform/*
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contains sensitive variable definitions)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan output files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Credentials files and secrets
gcp-credentials.json
*.json
*.pem
*.key
